                  borderRadius: '8px',
                  cursor: 'pointer',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '12px',
                  backgroundColor: formData.isFeatured ? 'var(--primary-light)' : 'transparent'
                }}>
                  <input
                    type="checkbox"
