    });
  });

  describe('D. Exact Money & Arbitrary Exponent Invariants', () => {
    test('handles zero-decimal currency (JPY) with exact integers', () => {
      const item1 = lineItem('A', 10000, 1);
      const order = {
        currency: 'JPY',
        items: [item1],
        subtotal: 10000,
        discount: 1500,
        totalAmount: 8500
      };

