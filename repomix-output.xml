  [data-theme="dark"] {
    --bg-primary: #0F172A;
    --card-bg: #1E293B;
    --sidebar-bg: #060A16;
    --sidebar-text: #64748B;
    --sidebar-text-hover: #CBD5E1;
    --sidebar-text-active: #FFFFFF;
    --sidebar-active-bg: rgba(255, 138, 0, 0.15);
    --sidebar-active-accent: #FF8A00;
    --sidebar-hover-bg: rgba(255, 255, 255, 0.05);
