        providerEventId: `evt_ref_partial_${crypto.randomUUID()}`,
        eventType: 'refund.created',
        providerPaymentId: paymentIntentId,
        providerRefundId,
        amountMinor: 4000,
        currency: 'USD',
        payloadHash: 'hash_refund_partial',
