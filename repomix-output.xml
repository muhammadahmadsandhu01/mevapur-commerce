const MAX_TITLE_LENGTH = 100;
const MAX_REFERENCE_LENGTH = 120;
const MAX_SNIPPET_LENGTH = 180;

const SECRET_PATTERNS = [
  /mongodb(?:\+srv)?:\/\/[^\s]+/gi,
  /bearer\s+[a-zA-Z0-9._\-]+/gi,
  /api[-_]?key\s*[:=]\s*['"]?[a-zA-Z0-9_\-]+['"]?/gi,
  /password\s*[:=]\s*['"]?[^\s'"]+['"]?/gi,
