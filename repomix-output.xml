          <button
            onClick={() => openModal()}
            style={{
              padding: '12px 20px',
              backgroundColor: 'var(--primary)',
              color: '#0B132B',
              border: 'none',
              borderRadius: '10px',
              fontWeight: '700',
              cursor: 'pointer',
              display: 'flex',
              alignItems: 'center',
              gap: '8px',
              boxShadow: '0 4px 12px rgba(255, 138, 0, 0.25)'
