                boxSizing: 'border-box'
              }}
              required
            />
          </div>

          {/* Province / State / Emirate */}
          <div>
            <label htmlFor="sim-province" className="block font-semibold text-slate-700 mb-1.5" style={{ display: 'block', fontWeight: '600', color: '#334155', marginBottom: '6px' }}>
              Province / State / Emirate
            </label>
            <input
