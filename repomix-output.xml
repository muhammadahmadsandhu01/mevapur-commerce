              }}
            />
          </div>

          {/* Postal Code */}
          <div>
            <label htmlFor="sim-postalCode" className="block font-semibold text-slate-700 mb-1.5" style={{ display: 'block', fontWeight: '600', color: '#334155', marginBottom: '6px' }}>
              Postal Code (Optional)
            </label>
            <input
