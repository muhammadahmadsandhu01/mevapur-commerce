  ): Promise<AdminPaymentSummary> => {
    const response = await api.post(`/payments/${paymentId}/collect`, { note });
    return response.data.data.payment;
  },

  reviewManual: async (
    paymentId: string,
    decision: 'approve' | 'reject',
