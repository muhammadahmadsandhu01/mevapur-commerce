              className="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 focus:ring-1 focus:ring-[#ff8a00] focus:border-[#ff8a00] outline-none shadow-xs font-mono"
              style={{
                width: '100%',
                padding: '10px 14px',
                borderRadius: '12px',
