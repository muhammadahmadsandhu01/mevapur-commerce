  resolveCountryCode,
  normalizePhone,
  convertToExactMoney,
  exactMoneyMatches,
  canonicalizeValue,
  computeFingerprint,
  evaluateDocument(doc, modelName, options = {}) {
    const evaluator = MODEL_EVALUATORS[modelName];
