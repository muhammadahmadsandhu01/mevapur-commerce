      select: jest.fn().mockResolvedValue(mockUser)
    });

    const req = {
      params: { id: '6ab8c3628e086c0d2d59dfce' },
      user: { _id: 'admin_id', role: 'admin' },
      ip: '127.0.0.1'
    };

    const res = {
