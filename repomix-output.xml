    sessionId,
    leaseExpiresAt,
    userScope,
    expectedFingerprint,
    expectedGeneration,
    hasSubmittedPayment,
    jitterProvider,
    onConverted: (convertedOrderDisplayId) => {
      onConverted(convertedOrderDisplayId);
    },
    onTerminalState: (status) => {
      onTerminalState?.(status);
