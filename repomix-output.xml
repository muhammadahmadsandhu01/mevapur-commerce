          </div>

          {/* Item Quantity */}
          <div>
            <label htmlFor="sim-qty" className="block font-semibold text-slate-700 mb-1.5" style={{ display: 'block', fontWeight: '600', color: '#334155', marginBottom: '6px' }}>
