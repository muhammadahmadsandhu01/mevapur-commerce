            size="lg"
            style={{ width: '100%', boxShadow: '0 4px 12px rgba(255, 138, 0, 0.25)' }}
            disabled={loading || !token}
            isLoading={loading}
          >
            {loading ? 'Activating Account...' : 'Complete Account Setup'}
          </Button>
        </form>
