    void bootstrap();
  }, [bootstrap]);

  if (!isInitialized) {
    return (
      <div
        role="status"
        aria-live="polite"
        style={{
          minHeight: '100vh',
          display: 'grid',
          placeItems: 'center',
          color: '#0B132B',
          fontWeight: 600,
        }}
      >
        Restoring your session...
      </div>
    );
  }

  return children;
}
