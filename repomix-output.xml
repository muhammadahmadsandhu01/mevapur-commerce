                <span className="font-mono text-xs font-semibold text-gray-800">{sessionId}</span>.
              </p>
              <button
                type="button"
                onClick={onClose}
                className="mt-5 rounded-xl border border-gray-300 px-6 py-2.5 font-semibold text-gray-700 hover:bg-gray-100"
              >
                Close
              </button>
            </div>
