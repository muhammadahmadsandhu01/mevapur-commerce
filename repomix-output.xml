            type="text"
            disabled={disabled}
            maxLength={2}
            value={profile.merchantCountry}
            onChange={(e) => handleChange('merchantCountry', e.target.value.toUpperCase().slice(0, 2))}
            placeholder="e.g. PK, AE, GB, US, DE"
