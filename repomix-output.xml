  return <Suspense fallback={<div style={{ minHeight: '300px', display: 'grid', placeItems: 'center' }}><Loader className="animate-spin" size={30} color="var(--accent-text)" aria-label="Loading reports view" /></div>}><ReportsView /></Suspense>;
