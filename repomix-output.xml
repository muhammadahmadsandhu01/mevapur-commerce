    await expect(PaymentWebhookProcessor.processSessionPaymentEvent({
      payment,
      claimedEvent,
      eventType: 'payment_intent.succeeded',
      providerEventId: claimedEvent.providerEventId,
      amountMinor: 5000,
      currency: 'USD',
      now: new Date()
    })).rejects.toThrow(/provider mismatch/i);
