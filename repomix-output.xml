<file path="frontend/src/components/assistant/HelpAssistant.module.css">
.launcher {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 80;
  min-height: 46px;
  padding: 0 18px;
  border: 0;
  border-radius: 999px;
  background: #0B132B;
