                <span style={{ fontWeight: '700', color: 'var(--text-primary)' }}>{codOrderToMark.orderId || codOrderToMark._id}</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '8px', fontSize: '14px' }}>
