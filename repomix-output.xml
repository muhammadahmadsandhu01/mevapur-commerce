    const preFingerprint = computeFingerprint({
      id: String(doc._id),
      currency,
      type: doc.type,
      value: doc.value,
      valueExact: doc.valueExact,
      minOrderAmount: doc.minOrderAmount,
      minOrderAmountExact: doc.minOrderAmountExact,
