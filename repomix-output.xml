            itemCopy.refundAmountExact = exact;
            fieldsWritten.push(`items.${idx}.refundAmountExact`);
            itemsUpdated = true;
            fieldStats.wouldBackfill++;
          }
        }
        return itemCopy;
      });

      if (itemsUpdated) {
        updates.items = updatedItems;
        hasNewWrites = true;
