    // Unknown currency code (XYZ) rejected
    const unknownCurrConfig = new MarketConfig({
      merchantCountry: 'PK',
      baseCurrency: 'PKR',
      enabledCurrencies: ['PKR', 'XYZ'],
      sellingMode: 'domestic'
