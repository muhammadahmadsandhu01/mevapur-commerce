    --sidebar-hover-bg: rgba(255, 255, 255, 0.07);
    --sidebar-border: rgba(255, 255, 255, 0.08);
    --text-primary: #111827;
    --text-secondary: #6B7280;
    --border-color: #E5E7EB;
    --hover-bg: #FFF4E6;
    --input-bg: #FFFFFF;
    --accent-text: #C2410C;
    --success-text: #166534;
    --warning-text: #92400E;
    --danger-text: #991B1B;
    --info-text: #0B132B;
    --info-light: rgba(11, 19, 43, 0.1);
