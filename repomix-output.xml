  },
  providerIdempotencyKey: {
    type: String,
    required: true,
    select: false,
    immutable: true,
    maxlength: 255
  },
  providerAttemptStatus: {
    type: String,
    enum: Object.values(PROVIDER_ATTEMPT_STATUSES),
    default: PROVIDER_ATTEMPT_STATUSES.UNCLAIMED,
