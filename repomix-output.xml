    test('handles 4-decimal currency with exact 4-decimal units', () => {
      const order = {
        currency: 'CLF',
        items: [{
          product: new mongoose.Types.ObjectId(),
          priceExact: { amountMinor: '12345678', currency: 'CLF', exponent: 4 },
