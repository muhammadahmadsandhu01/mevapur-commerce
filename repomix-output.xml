    unique: true,
    partialFilterExpression: {
      status: {
        $in: [
          'Pending',
          'Processing',
          'RequiresCustomerAction',
          'Authorized',
          'AwaitingCustomerPayment',
          'AwaitingVerification'
        ]
      }
    },
    name: 'unique_active_order_payment'
  }
);
paymentSchema.index(
  { checkoutSessionObjectId: 1 },
  {
    unique: true,
    partialFilterExpression: {
      checkoutSessionObjectId: { $type: 'objectId' },
      status: {
        $in: [
          'Pending',
          'Processing',
          'RequiresCustomerAction',
          'Authorized',
          'AwaitingCustomerPayment',
          'AwaitingVerification'
        ]
      }
    },
    name: 'unique_active_session_payment'
  }
);
paymentSchema.index(
  { provider: 1, providerPaymentId: 1 },
  {
    unique: true,
    sparse: true,
    name: 'unique_provider_payment_reference'
  }
);
paymentSchema.index({ order: 1, createdAt: -1 });
paymentSchema.index(
  { customerReferenceHash: 1 },
  {
    unique: true,
    sparse: true,
    name: 'unique_manual_customer_reference'
  }
);

module.exports = mongoose.models.Payment || mongoose.model('Payment', paymentSchema);
