    active: brands.filter(b => b.isActive).length,
    featured: brands.filter(b => b.isFeatured).length,
    withProducts: brands.filter(b => (b._count?.products || 0) > 0).length
  };

  return (
    <div style={{ maxWidth: '1400px', margin: '0 auto' }}>
