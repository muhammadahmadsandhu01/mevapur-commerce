            style={{
              width: '100%',
              padding: '10px 14px',
              borderRadius: '12px',
              border: '1px solid #cbd5e1',
              backgroundColor: disabled ? '#f8fafc' : '#ffffff',
              color: '#0f172a',
              fontSize: '12px',
              outline: 'none',
              boxSizing: 'border-box'
