# ==============================================================================
# MevaPur Commerce Production-Grade Docker Compose Topology
# Pinned Runtimes: Node 24.20.0, MongoDB 7.0.14, Redis 7.4.1, Nginx 1.27.2
# ==============================================================================

services:
  # ----------------------------------------------------------------------------
  # 1. Reverse Proxy Gateway (Nginx)
  # ----------------------------------------------------------------------------
  proxy:
    image: nginx:1.27.2-alpine
    container_name: mevapur-proxy
    restart: unless-stopped
    ports:
      - "80:80"
    environment:
      - STOREFRONT_HOST=${STOREFRONT_HOST:-localhost}
      - ADMIN_HOST=${ADMIN_HOST:-admin.localhost}
      - API_HOST=${API_HOST:-api.localhost}
    volumes:
      - ./docker/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./docker/nginx/templates/default.conf.template:/etc/nginx/templates/default.conf.template:ro
    networks:
      - frontend_net
    depends_on:
      backend:
        condition: service_healthy
      frontend:
        condition: service_healthy
      admin-panel:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null --header=\"Host: ${STOREFRONT_HOST:-localhost}\" http://127.0.0.1:80/healthz || exit 1"]
      interval: 10s
      timeout: 5s
      start_period: 10s
      retries: 3

  # ----------------------------------------------------------------------------
  # 2. Backend API Service
  # ----------------------------------------------------------------------------
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    image: mevapur/backend:${RELEASE_TAG:-latest}
    container_name: mevapur-backend
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - APP_ENV=development
      - PORT=5000
      - FRONTEND_URL=http://${STOREFRONT_HOST:-localhost}
      - ADMIN_URL=http://${ADMIN_HOST:-admin.localhost}
      - BACKEND_PUBLIC_URL=http://${API_HOST:-api.localhost}
      - MONGODB_URI=mongodb://${MONGO_APP_USER:-app_user}:${MONGO_APP_PASSWORD:-app_password}@mongodb:27017/${MONGO_APP_DATABASE:-mevapur-commerce}?authSource=${MONGO_APP_DATABASE:-mevapur-commerce}&replicaSet=rs0&directConnection=true
      - REDIS_URL=redis://:${REDIS_PASSWORD:-changeme_redis_password}@redis:6379
      - RATE_LIMIT_STORE=redis
      - TRUST_PROXY=1
      - AUTH_COOKIE_SECURE=false
      - AUTH_COOKIE_SAME_SITE=lax
      - EMAIL_MODE=mock
      - EMAIL_BRAND_NAME=HARZAAR
      - COMMERCE_MONEY_MODE=legacy
      - COMMERCE_TWO_PHASE_CHECKOUT_ENABLED=true
      - LOG_FILE_ENABLED=false
      - JWT_SECRET=test_jwt_secret_must_be_at_least_32_characters_long_for_security
    networks:
      - frontend_net
      - backend_net
    depends_on:
      mongodb:
        condition: service_healthy
      redis:
        condition: service_healthy
      mongodb-init:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD-SHELL", "node -e 'require(\"http\").get(\"http://127.0.0.1:5000/health/ready\", (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on(\"error\", () => process.exit(1))'"]
      interval: 5s
      timeout: 5s
      start_period: 5s
      retries: 10
    security_opt:
      - no-new-privileges:true

  # ----------------------------------------------------------------------------
  # 3. Storefront Next.js Service
  # ----------------------------------------------------------------------------
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        - NEXT_PUBLIC_SITE_NAME=${NEXT_PUBLIC_SITE_NAME:-HARZAAR}
        - NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL:-https://storefront.mevapur.test}
        - NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://api.mevapur.test}
        - NEXT_PUBLIC_DEFAULT_CURRENCY=PKR
        - NEXT_PUBLIC_DEFAULT_LOCALE=en-PK
    image: mevapur/frontend:${RELEASE_TAG:-latest}
    container_name: mevapur-frontend
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - PORT=3000
      - INTERNAL_API_URL=http://backend:5000
    networks:
      - frontend_net
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "node -e 'require(\"http\").get(\"http://127.0.0.1:3000/healthz\", (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on(\"error\", () => process.exit(1))'"]
      interval: 15s
      timeout: 5s
      start_period: 15s
      retries: 3
    security_opt:
      - no-new-privileges:true

  # ----------------------------------------------------------------------------
  # 4. Admin Panel Next.js Service
  # ----------------------------------------------------------------------------
  admin-panel:
    build:
      context: ./admin-panel
      dockerfile: Dockerfile
      args:
        - NEXT_PUBLIC_SITE_NAME=${NEXT_PUBLIC_SITE_NAME:-HARZAAR}
        - NEXT_PUBLIC_ADMIN_URL=${NEXT_PUBLIC_ADMIN_URL:-https://admin.mevapur.test}
        - NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://api.mevapur.test}
    image: mevapur/admin-panel:${RELEASE_TAG:-latest}
    container_name: mevapur-admin-panel
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - PORT=3001
      - INTERNAL_API_URL=http://backend:5000
    networks:
      - frontend_net
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "node -e 'require(\"http\").get(\"http://127.0.0.1:3001/healthz\", (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on(\"error\", () => process.exit(1))'"]
      interval: 15s
      timeout: 5s
      start_period: 15s
      retries: 3
    security_opt:
      - no-new-privileges:true

  # ----------------------------------------------------------------------------
  # 5. Background Outbox Worker Daemon
  # ----------------------------------------------------------------------------
  worker-outbox:
    build:
      context: ./backend
      dockerfile: Dockerfile.worker
    image: mevapur/worker:${RELEASE_TAG:-latest}
    container_name: mevapur-worker-outbox
    restart: unless-stopped
    command: ["node", "scripts/workers/processTransactionalOutbox.js", "--loop", "--intervalMs=5000"]
    environment:
      - NODE_ENV=production
      - LOG_FILE_ENABLED=false
      - MONGODB_URI=mongodb://${MONGO_APP_USER:-app_user}:${MONGO_APP_PASSWORD:-app_password}@mongodb:27017/${MONGO_APP_DATABASE:-mevapur-commerce}?authSource=${MONGO_APP_DATABASE:-mevapur-commerce}&replicaSet=rs0&directConnection=true
      - HEARTBEAT_FILE=/tmp/worker-outbox-heartbeat.json
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=32m
    networks:
      - backend_net
    depends_on:
      mongodb:
        condition: service_healthy
      mongodb-init:
        condition: service_completed_successfully
    security_opt:
      - no-new-privileges:true

  # ----------------------------------------------------------------------------
  # 6. Background Checkout Session Reconciliation Worker Daemon
  # ----------------------------------------------------------------------------
  worker-reconcile-sessions:
    build:
      context: ./backend
      dockerfile: Dockerfile.worker
    image: mevapur/worker:${RELEASE_TAG:-latest}
    container_name: mevapur-worker-reconcile
    restart: unless-stopped
    command: ["node", "scripts/workers/reconcileExpiredCheckoutSessions.js"]
    environment:
      - NODE_ENV=production
      - LOG_FILE_ENABLED=false
      - MONGODB_URI=mongodb://${MONGO_APP_USER:-app_user}:${MONGO_APP_PASSWORD:-app_password}@mongodb:27017/${MONGO_APP_DATABASE:-mevapur-commerce}?authSource=${MONGO_APP_DATABASE:-mevapur-commerce}&replicaSet=rs0&directConnection=true
      - HEARTBEAT_FILE=/tmp/worker-reconcile-heartbeat.json
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=32m
    networks:
      - backend_net
    depends_on:
      mongodb:
        condition: service_healthy
      mongodb-init:
        condition: service_completed_successfully
    security_opt:
      - no-new-privileges:true

  # ----------------------------------------------------------------------------
  # 7. MongoDB Primary Replica Set Database
  # ----------------------------------------------------------------------------
  mongodb:
    image: mongo:7.0.14-jammy
    container_name: mevapur-mongodb
    restart: unless-stopped
    # --auth enforces role-based access control.
    # MONGO_INITDB_ROOT_USERNAME/PASSWORD are consumed by the official Docker
    # entrypoint to create the admin root user before mongod starts with --auth,
    # using the localhost exception window. The mongodb-init container then
    # connects with these credentials to initiate rs0 and provision app_user.
    # --keyFile is required by MongoDB when --auth and --replSet are both active,
    # even for a single-node replica set. The key material is never stored in this
    # repository. It is supplied at runtime:
    #   CI:         generated by the workflow (openssl rand -base64 756 > /tmp/mongo-keyfile)
    #               and mounted via docker-compose.ci.yml volumes override.
    #   Production: supply via Docker secrets, a secrets manager, or deployment
    #               tooling. chmod 400, chown 999:999 must be applied before startup.
    command: ["--replSet", "rs0", "--bind_ip_all", "--auth", "--keyFile", "/etc/mongodb/keyfile"]
    environment:
      - MONGO_INITDB_ROOT_USERNAME=${MONGO_ROOT_USER:-root}
      - MONGO_INITDB_ROOT_PASSWORD=${MONGO_ROOT_PASSWORD:-rootpassword}
    volumes:
      - mongodb_data:/data/db
    networks:
      - backend_net
    healthcheck:
      test: ["CMD-SHELL", "mongosh -u ${MONGO_ROOT_USER:-root} -p ${MONGO_ROOT_PASSWORD:-rootpassword} --authenticationDatabase admin --quiet --eval 'try { rs.status().ok === 1 && db.hello().isWritablePrimary === true ? quit(0) : quit(1) } catch(e) { quit(1) }'"]
      interval: 5s
      timeout: 5s
      start_period: 15s
      retries: 20

  # ----------------------------------------------------------------------------
  # 8. MongoDB Replica Set Initiator & User Provisioner
  # ----------------------------------------------------------------------------
  mongodb-init:
    image: node:24.20.0-alpine3.24
    container_name: mevapur-mongodb-init
    restart: "no"
    working_dir: /app
    environment:
      - NODE_PATH=/app/node_modules
      - MONGO_HOST=mongodb:27017
      - MONGO_INITDB_ROOT_USERNAME=${MONGO_ROOT_USER:-root}
      - MONGO_INITDB_ROOT_PASSWORD=${MONGO_ROOT_PASSWORD:-rootpassword}
      - MONGO_APP_DATABASE=${MONGO_APP_DATABASE:-mevapur-commerce}
      - MONGO_APP_USER=${MONGO_APP_USER:-app_user}
      - MONGO_APP_PASSWORD=${MONGO_APP_PASSWORD:-app_password}
    volumes:
      - ./backend/node_modules:/app/node_modules:ro
      - ./scripts/ops:/app/scripts/ops:ro
    command: ["node", "scripts/ops/init-mongo-replica-set.js"]
    networks:
      - backend_net
    depends_on:
      mongodb:
        condition: service_started

  # ----------------------------------------------------------------------------
  # 9. Redis Distributed Cache & Rate Limiting Store
  # ----------------------------------------------------------------------------
  redis:
    image: redis:7.4.1-alpine3.20
    container_name: mevapur-redis
    restart: unless-stopped
    command: ["redis-server", "--maxmemory", "256mb", "--maxmemory-policy", "volatile-lru", "--requirepass", "${REDIS_PASSWORD:-changeme_redis_password}"]
    volumes:
      - redis_data:/data
    networks:
      - backend_net
    healthcheck:
      test: ["CMD-SHELL", "REDISCLI_AUTH=${REDIS_PASSWORD:-changeme_redis_password} redis-cli ping || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3

  # ----------------------------------------------------------------------------
  # 10. Prometheus Monitoring Service (Optional profile: monitoring)
  # ----------------------------------------------------------------------------
  prometheus:
    image: prom/prometheus:v2.55.1
    container_name: mevapur-prometheus
    profiles:
      - monitoring
    restart: unless-stopped
    volumes:
      - ./docker/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./docker/monitoring/alert.rules.yml:/etc/prometheus/alert.rules.yml:ro
    networks:
      - backend_net
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--web.console.libraries=/usr/share/prometheus/console_libraries"
      - "--web.console.templates=/usr/share/prometheus/consoles"

networks:
  frontend_net:
    driver: bridge
  backend_net:
    driver: bridge
    internal: true

volumes:
  mongodb_data:
    name: mevapur_mongodb_data
  redis_data:
    name: mevapur_redis_data
</file>

<file path=".github/workflows/assistant-ci.yml">
name: Assistant and Backend CI

on:
  push:
    branches:
      - 'develop/**'
      - 'main'
  pull_request:
    branches:
      - 'develop/**'
      - 'main'

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  assistant-integrity-and-tests:
    name: Assistant Integrity and Backend Test Matrix
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24.20.0'
          cache: 'npm'
          cache-dependency-path: |
            backend/package-lock.json
            frontend/package-lock.json
            admin-panel/package-lock.json

      - name: Install Backend Dependencies
        working-directory: backend
        run: npm ci

      - name: Lint Backend Code
        working-directory: backend
        run: npm run lint

      - name: Run CI Test Matrix (Knowledge Check + Full Test Suite)
        working-directory: backend
        env:
          NODE_ENV: test
          MONGODB_URI: ''
        run: npm run test:ci

      - name: Run Backend Phase 7 Returns, Refunds, Disputes and Reconciliation Tests
        working-directory: backend
        env:
          NODE_ENV: test
          MONGODB_URI: ''
        run: npm run test:phase7

      - name: Run Backend Phase 8 Notifications, Invoices and Exception Tests
        working-directory: backend
        env:
          NODE_ENV: test
          MONGODB_URI: ''
        run: npm run test:phase8

      - name: Run Backend Phase 9 Infrastructure, Health and Rate Limit Tests
        working-directory: backend
        env:
          NODE_ENV: test
          MONGODB_URI: ''
        run: npm run test:phase9

      - name: Run Backend Phase 10 Deterministic UAT Fixture and Reset Tests
        working-directory: backend
        run: npm run test:phase10

      - name: Install Frontend Dependencies
        working-directory: frontend
        run: npm ci

      - name: Lint Frontend Code
        working-directory: frontend
        run: npm run lint

      - name: Run Storefront Assistant UI Component Tests (Contracts and Real DOM)
        working-directory: frontend
        run: npm run test:assistant

      - name: Run Storefront Category Visibility Tests
        working-directory: frontend
        run: npm run test:categories

      - name: Run Storefront Phase 6C Global Checkout Tests
        working-directory: frontend
        run: |
          node --test tests/phase6cStorefrontCheckout.test.mts
          npx --no-install vitest run tests/phase6cStorefrontCheckout.dom.test.tsx

      - name: Run Storefront Phase 6D-3 Shipping Checkout Tests
        working-directory: frontend
        run: npm run test:phase6d3

      - name: Run Storefront Phase 6D-4 Tax and Customs Checkout Tests
        working-directory: frontend
        run: npm run test:phase6d4

      - name: Run Storefront Phase 8 Customer Recovery Tests
        working-directory: frontend
        run: npm run test:phase8

      - name: Run Storefront Phase 6D-1 Registration and Full Aggregate Test Suite
        working-directory: frontend
        run: npm test

      - name: Build Frontend Application
        working-directory: frontend
        env:
          NEXT_PUBLIC_SITE_NAME: 'HARZAAR'
          NEXT_PUBLIC_SITE_URL: 'https://storefront.mevapur.test'
          NEXT_PUBLIC_API_URL: 'https://api.mevapur.test'
        run: npm run build

      - name: Install Playwright Chromium for Security Smoke Test
        working-directory: frontend
        run: npx playwright install --with-deps chromium

      - name: Run Storefront Post-Build Standalone Server and Security Tests
        working-directory: frontend
        env:
          NEXT_PUBLIC_SITE_NAME: 'HARZAAR'
          NEXT_PUBLIC_SITE_URL: 'https://storefront.mevapur.test'
          NEXT_PUBLIC_API_URL: 'https://api.mevapur.test'
        run: npm run test:postbuild

      - name: Install Admin Panel Dependencies
        working-directory: admin-panel
        run: npm ci

      - name: Lint Admin Panel Code
        working-directory: admin-panel
        run: npm run lint

      - name: Run Admin Panel Assistant UI Component Tests (Contracts and Real DOM)
        working-directory: admin-panel
        run: npm run test:assistant

      - name: Run Admin Category Contract and DOM Tests
        working-directory: admin-panel
        run: npm run test:categories

      - name: Run Admin Phase 6C Commerce Governance Tests
        working-directory: admin-panel
        run: |
          node --test tests/phase6cAdminGovernance.test.mts
          npx --no-install vitest run tests/phase6cAdminGovernance.dom.test.tsx

      - name: Run Admin Phase 6D-3 Shipping Governance Tests
        working-directory: admin-panel
        run: npm run test:phase6d3

      - name: Run Admin Phase 6D-4 Tax and Customs Governance Tests
        working-directory: admin-panel
        run: npm run test:phase6d4

      - name: Run Admin Phase 8 Operations and Exception Tests
        working-directory: admin-panel
        run: npm run test:phase8

      - name: Build Admin Panel Application
        working-directory: admin-panel
        env:
          NEXT_PUBLIC_SITE_NAME: 'HARZAAR Admin'
          NEXT_PUBLIC_ADMIN_URL: 'https://admin.mevapur.test'
          NEXT_PUBLIC_API_URL: 'https://api.mevapur.test'
        run: npm run build

  phase9-infrastructure-ci:
    name: Phase 9 Production Infrastructure and Security Matrix
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24.20.0'
          cache: 'npm'
          cache-dependency-path: backend/package-lock.json

      - name: Install Backend Dependencies
        working-directory: backend
        run: npm ci

      - name: Validate Docker Compose Configuration
        run: |
          docker compose -f docker-compose.yml config --quiet
          docker compose -f docker-compose.yml -f docker-compose.ci.yml config --quiet

      - name: Pull Pinned Base Images
        run: |
          docker pull node:24.20.0-alpine3.24
          docker pull mongo:7.0.14-jammy
          docker pull redis:7.4.1-alpine3.20
          docker pull nginx:1.27.2-alpine
          docker pull prom/prometheus:v2.55.1
          docker pull aquasec/trivy:0.56.2

      - name: Validate Official MongoDB Tools Version
        run: |
          docker run --rm mongo:7.0.14-jammy mongodump --version
          docker run --rm mongo:7.0.14-jammy mongorestore --version

      - name: Validate Prometheus Configuration and Rules
        run: |
          docker run --rm --entrypoint=/bin/promtool -v ${{ github.workspace }}/docker/monitoring:/etc/prometheus prom/prometheus:v2.55.1 check config /etc/prometheus/prometheus.yml
          docker run --rm --entrypoint=/bin/promtool -v ${{ github.workspace }}/docker/monitoring:/etc/prometheus prom/prometheus:v2.55.1 check rules /etc/prometheus/alert.rules.yml

      - name: Fetch Baseline Commit for Distinct Rollback Rehearsal
        run: |
          git fetch origin 6a7ce98dbd5499dfb1d9cb16990f4999e6da05b8 || git fetch --depth=100 origin develop/global-commerce-rc3

      - name: Build Application Container Images
        run: docker compose build

      - name: Build Distinct Release A (Baseline) and Release B (Candidate) Images
        run: |
          git worktree add /tmp/baseline-src 6a7ce98dbd5499dfb1d9cb16990f4999e6da05b8
          docker build -t mevapur/backend:phase9-baseline-6a7ce98d /tmp/baseline-src/backend
          docker build -t mevapur/backend:phase9-candidate-${{ github.sha }} ./backend
          IMAGE_A_ID=$(docker image inspect mevapur/backend:phase9-baseline-6a7ce98d --format '{{.Id}}')
          IMAGE_B_ID=$(docker image inspect mevapur/backend:phase9-candidate-${{ github.sha }} --format '{{.Id}}')
          echo "Release A Image ID (6a7ce98d): $IMAGE_A_ID"
          echo "Release B Image ID (${{ github.sha }}): $IMAGE_B_ID"
          if [ "$IMAGE_A_ID" = "$IMAGE_B_ID" ]; then
            echo "ERROR: Release A and Release B image IDs are identical! Rehearsal requires distinct images."
            exit 1
          fi

      - name: Run Non-Root User & Image Secret Inspection
        run: |
          docker run --rm mevapur/backend:latest id -u | grep -E '^1000$' || (echo "Backend container runs as root!" && exit 1)
          docker run --rm mevapur/frontend:latest id -u | grep -E '^1000$' || (echo "Frontend container runs as root!" && exit 1)
          docker run --rm mevapur/admin-panel:latest id -u | grep -E '^1000$' || (echo "Admin container runs as root!" && exit 1)
          docker run --rm mevapur/worker:latest id -u | grep -E '^1000$' || (echo "Worker container runs as root!" && exit 1)

      - name: Run Trivy Vulnerability Scanner on Images
        run: |
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 0 mevapur/backend:latest
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 0 mevapur/frontend:latest
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 0 mevapur/admin-panel:latest
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.56.2 image --severity HIGH,CRITICAL --exit-code 0 mevapur/worker:latest

      - name: Execute Phase 9 Unit and Integration Test Matrix
        working-directory: backend
        run: npm run test:phase9

      - name: Generate MongoDB Replica-Set Keyfile
        # MongoDB enforces strict keyfile permissions: the file must be mode
        # 400 or 600 and owned by the mongod user (uid 999). The CI runner
        # cannot chown to uid 999 without sudo.
        #
        # Solution: run a disposable mongo:7.0.14-jammy container as uid 999
        # (which has openssl) to generate the keyfile and write it to /tmp on
        # the host via a bind-mount. The resulting /tmp/mongo-keyfile is owned
        # by uid 999 with mode 400 — exactly what MongoDB requires.
        #
        # Cleanup: the file is owned by uid 999 so the runner cannot rm it
        # directly. The cleanup step uses 'sudo rm -f' (ubuntu-latest runners
        # have passwordless sudo) to remove it unconditionally.
        #
        # The keyfile is:
        #   - written to /tmp (outside the repository checkout)
        #   - never printed in logs
        #   - never committed or staged in git
        #   - never baked into any image layer
        #   - removed unconditionally by the cleanup step
        run: |
          docker run --rm \
            --user 999:999 \
            -v /tmp:/output \
            mongo:7.0.14-jammy \
            sh -c "openssl rand -base64 756 > /output/mongo-keyfile && chmod 400 /output/mongo-keyfile"
          test -s /tmp/mongo-keyfile

      - name: Start Disposable Docker Infrastructure Topology (CI Override)
        run: |
          docker compose -f docker-compose.yml -f docker-compose.ci.yml -p mevapur-ci --profile monitoring up -d --wait || (docker compose -f docker-compose.yml -f docker-compose.ci.yml -p mevapur-ci logs && exit 1)
          docker compose -f docker-compose.yml -f docker-compose.ci.yml -p mevapur-ci ps

      - name: Validate Container Security & Network Port Ingress Isolation
        run: node scripts/ops/verify-container-security-runtime.js

      - name: Execute Live MongoDB Replica Set Runtime Verification
        run: node scripts/ops/verify-mongo-runtime.js
        env:
          MONGO_HOST: 127.0.0.1:27017
          MONGO_ROOT_USER: root
          MONGO_ROOT_PASSWORD: rootpassword
          MONGO_APP_DATABASE: mevapur-commerce
          MONGO_APP_USER: app_user
          MONGO_APP_PASSWORD: app_password

      - name: Execute Live Redis Distributed Rate Limiting Runtime Verification
        run: node scripts/ops/verify-redis-runtime.js
        env:
          REDIS_HOST: 127.0.0.1
          REDIS_PORT: 6379
          REDIS_PASSWORD: changeme_redis_password

      - name: Execute Live Nginx Gateway Host Routing and Webhook Byte Verification
        run: node scripts/ops/verify-nginx-runtime.js
        env:
          PROXY_HOST: 127.0.0.1
          PROXY_PORT: 80
          STOREFRONT_HOST: localhost
          ADMIN_HOST: admin.localhost
          API_HOST: api.localhost

      - name: Execute Live Worker Heartbeat and SIGTERM Graceful Shutdown Verification
        run: node scripts/ops/verify-worker-runtime.js

      - name: Execute Live Prometheus Target Discovery and Metric Scrape Verification
        run: node scripts/ops/verify-prometheus-runtime.js
        env:
          PROM_HOST: 127.0.0.1
          PROM_PORT: 9090

      - name: Execute Live Backup, Corruption Rejection and Safe Restore Verification
        run: node scripts/ops/verify-backup-restore-runtime.js
        env:
          MONGO_HOST: 127.0.0.1:27017
          MONGO_ROOT_USER: root
          MONGO_ROOT_PASSWORD: rootpassword

      - name: Execute Live Distinct Container A -> B -> A Rollback Rehearsal
        run: |
          node scripts/ops/verify-container-rollback-runtime.js \
            --imageA=mevapur/backend:phase9-baseline-6a7ce98d \
            --imageB=mevapur/backend:phase9-candidate-${{ github.sha }} \
            --network=mevapur-ci_backend_net
        env:
          MONGO_HOST: 127.0.0.1:27017
          MONGO_APP_USER: app_user
          MONGO_APP_PASSWORD: app_password

      - name: Unconditional Container, Worktree & Volume Cleanup
        if: always()
        run: |
          docker compose -f docker-compose.yml -f docker-compose.ci.yml -p mevapur-ci --profile monitoring down -v --remove-orphans
          git worktree remove --force /tmp/baseline-src 2>/dev/null || true
          # /tmp/mongo-keyfile is owned by uid 999 (generated inside the mongo
          # container). The runner user cannot rm it directly; use sudo which
          # is available passwordless on ubuntu-latest GitHub Actions runners.
          sudo rm -f /tmp/mongo-keyfile 2>/dev/null || true
</file>

</files>
