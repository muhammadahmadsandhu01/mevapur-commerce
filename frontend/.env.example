# ==============================================================================
# STOREFRONT ENVIRONMENT VARIABLES (WHITE-LABEL CONFIGURATION)
# ==============================================================================
# NOTE: All variables prefixed with NEXT_PUBLIC_* are embedded at build time into
# the client-side JavaScript bundle. In hosted environments (e.g. Vercel, Render),
# updating these variables requires triggering a new build/deployment to take effect.
# Public variables must NEVER contain secrets or private credentials.
# ==============================================================================

# Core API and Site Origins
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Merchant Brand Identity (White-Label)
NEXT_PUBLIC_SITE_NAME=HARZAAR
NEXT_PUBLIC_LEGAL_NAME=HARZAAR LLC
NEXT_PUBLIC_TAGLINE=CHOOSE BEYOND.
NEXT_PUBLIC_SHORT_DESCRIPTION=A modern, configurable commerce platform.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Logo & Visual Assets
# Logo display mode: 'wordmark' (default dynamic symbol + text) or 'image' (custom graphic)
NEXT_PUBLIC_LOGO_MODE=wordmark
NEXT_PUBLIC_LOGO_PATH=/brand/logo.svg
NEXT_PUBLIC_LOGO_LIGHT_PATH=/brand/logo-light.svg
NEXT_PUBLIC_LOGO_DARK_PATH=/brand/logo-dark.svg
NEXT_PUBLIC_SYMBOL_PATH=/brand/symbol.svg
NEXT_PUBLIC_FAVICON_PATH=/brand/favicon.svg
NEXT_PUBLIC_SOCIAL_IMAGE_PATH=/brand/logo.svg

# Theme Color Palette (Hex format: #RRGGBB)
NEXT_PUBLIC_THEME_PRIMARY_COLOR=#0B132B
NEXT_PUBLIC_THEME_ACCENT_COLOR=#FF8A00
NEXT_PUBLIC_THEME_SURFACE_COLOR=#F7F7F5
NEXT_PUBLIC_THEME_MUTED_COLOR=#6B7280

# Public Contact Information (Optional; empty values are omitted from UI)
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SALES_EMAIL=sales@example.com
NEXT_PUBLIC_SUPPORT_PHONE=+92 300 1234567
NEXT_PUBLIC_WHATSAPP=+92 300 1234567
NEXT_PUBLIC_STORE_ADDRESS=123 Commerce Avenue, Lahore, Pakistan
NEXT_PUBLIC_BUSINESS_HOURS=Mon - Sat: 9:00 AM - 6:00 PM

# Search & SEO Indexing
NEXT_PUBLIC_SEARCH_INDEXING_ENABLED=false

# Social Media Links (Optional)
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/example
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/example
NEXT_PUBLIC_SOCIAL_X=https://x.com/example
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/example
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/example
NEXT_PUBLIC_SOCIAL_TIKTOK=https://tiktok.com/@example
