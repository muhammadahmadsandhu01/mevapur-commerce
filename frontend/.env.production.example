# ==============================================================================
# PRODUCTION STOREFRONT ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# In production builds, NEXT_PUBLIC_API_URL, NEXT_PUBLIC_SITE_URL, and
# NEXT_PUBLIC_SITE_NAME are mandatory.
# NEXT_PUBLIC_* variables are embedded at build time. Updates require a new build.
# Public variables must NEVER contain secrets.
# ==============================================================================

NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_SITE_NAME=YOUR_BRAND_NAME
NEXT_PUBLIC_LEGAL_NAME=YOUR_LEGAL_ENTITY_NAME
NEXT_PUBLIC_TAGLINE=CHOOSE BEYOND.
NEXT_PUBLIC_SHORT_DESCRIPTION=A modern, configurable commerce platform.
NEXT_PUBLIC_THEME_PRIMARY_COLOR=#0B132B
NEXT_PUBLIC_THEME_ACCENT_COLOR=#FF8A00
NEXT_PUBLIC_SEARCH_INDEXING_ENABLED=true
