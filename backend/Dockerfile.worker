# ==============================================================================
# MevaPur Commerce Background Workers — Multi-Stage Production Dockerfile
# Base Image: node:24.20.0-alpine3.21 (Exact pinned Node.js 24 runtime)
# ==============================================================================

FROM node:24.20.0-alpine3.21 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM node:24.20.0-alpine3.21 AS runner
WORKDIR /app
ENV NODE_ENV=production

# Install dumb-init for proper signal handling (SIGTERM / SIGINT graceful shutdown)
RUN apk add --no-cache dumb-init

# Copy production node_modules and worker sources
COPY --chown=node:node --from=dependencies /app/node_modules ./node_modules
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node common ./common
COPY --chown=node:node config ./config
COPY --chown=node:node constants ./constants
COPY --chown=node:node database ./database
COPY --chown=node:node models ./models
COPY --chown=node:node modules ./modules
COPY --chown=node:node operations ./operations
COPY --chown=node:node repositories ./repositories
COPY --chown=node:node services ./services
COPY --chown=node:node utils ./utils
COPY --chown=node:node validators ./validators
COPY --chown=node:node scripts ./scripts

USER node

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "scripts/workers/processTransactionalOutbox.js", "--loop", "--intervalMs=5000"]
