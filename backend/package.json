{
  "name": "mevapur-backend",
  "version": "1.0.0",
  "description": "MevaPur E-Commerce Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --watchAll --verbose",
    "test:ci": "npm run assistant:knowledge:check && jest --coverage --forceExit --runInBand",
    "test:phase6d4": "npm run assistant:knowledge:check && jest tests/unit/commerce/phase6d4-tax-governance.unit.test.js tests/unit/commerce/phase6d4b-tax-runtime.unit.test.js tests/unit/commerce/phase6d4c-return-tax-duty.unit.test.js tests/unit/commerce/taxDutyConfiguration.test.js tests/unit/services/return-money-allocation.service.test.js tests/unit/services/return-state-machine.service.test.js tests/integration/return-refund-integrity.integration.test.js tests/unit/phase6d4-tax-migration.unit.test.js tests/unit/tax-governance-reconciliation.unit.test.js --runInBand --watchAll=false",
    "test:phase6d5a": "npm run assistant:knowledge:check && jest tests/unit/commerce/stock-hold-lease.unit.test.js tests/integration/commerce/two-phase-checkout.integration.test.js tests/integration/commerce/session-webhook-conversion.integration.test.js tests/integration/commerce/stock-hold-concurrency.integration.test.js tests/integration/commerce/checkout-session-races.integration.test.js tests/unit/commerce/checkout-session-workers.unit.test.js tests/unit/commerce/checkout-session-migration.unit.test.js --runInBand --watchAll=false",
    "test:phase7": "npm run assistant:knowledge:check && jest tests/unit/phase7-policy-routing.unit.test.js tests/unit/phase7-dispute-service.unit.test.js tests/unit/phase7-finance-reconciliation.unit.test.js tests/unit/phase7-rto.unit.test.js tests/unit/phase7-migration.unit.test.js tests/integration/phase7-disputes-and-reconciliation.integration.test.js tests/integration/phase7-concurrency-and-races.integration.test.js tests/integration/return-refund-integrity.integration.test.js tests/unit/services/return-money-allocation.service.test.js tests/unit/services/return-state-machine.service.test.js --runInBand --watchAll=false",
    "test:phase8": "npm run assistant:knowledge:check && jest tests/unit/phase8-transactional-notifications.unit.test.js tests/unit/phase8-template-localization.unit.test.js tests/unit/phase8-document-truthfulness.unit.test.js tests/unit/phase8-exception-queue.unit.test.js tests/unit/phase8-migration.unit.test.js tests/integration/phase8-customer-recovery.integration.test.js tests/integration/phase8-admin-exceptions.integration.test.js tests/integration/phase8-domain-event-wiring.integration.test.js tests/integration/phase8-outbox-worker.integration.test.js tests/integration/phase8-document-concurrency.integration.test.js tests/integration/phase8-exception-concurrency.integration.test.js --runInBand --watchAll=false",
    "test:assistant": "npm run assistant:knowledge:check && jest tests/unit/assistant tests/integration/assistant.integration.test.js --runInBand --watchAll=false",
    "ci:assistant": "npm run test:assistant",
    "reconcile:tax": "node scripts/reconciliation/taxGovernanceReconciliation.js",
    "reconcile:checkout-sessions": "node scripts/workers/reconcileExpiredCheckoutSessions.js",
    "purge:checkout-sessions": "node scripts/workers/purgeAbandonedCheckoutSessions.js",
    "migrate:phase6d4": "node scripts/migrations/phase6d4-tax-customs-governance.js",
    "lint": "eslint . --max-warnings=0",
    "seed": "node database/seeders/index.js",
    "bootstrap:initial-admin": "node scripts/create-admin.js",
    "recover:initial-admin-password": "node scripts/recover-initial-admin-password.js",
    "assistant:knowledge:check": "node scripts/build-assistant-knowledge-index.js --check",
    "assistant:knowledge:build": "node scripts/build-assistant-knowledge-index.js --write"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "1.13.13",
    "mongoose": "^8.24.1",
    "morgan": "1.12.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "redis": "4.7.0",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "stripe": "^22.3.2",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "14.0.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^9.0.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "6.3.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
