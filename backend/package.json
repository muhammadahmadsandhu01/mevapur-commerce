{
  "name": "mevapur-backend",
  "version": "1.0.0",
  "description": "MevaPur E-Commerce Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --watchAll --verbose",
    "test:ci": "jest --coverage --forceExit",
    "seed": "node database/seeders/index.js",
    "bootstrap:initial-admin": "node scripts/create-admin.js",
    "recover:initial-admin-password": "node scripts/recover-initial-admin-password.js"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1",
    "morgan": "^1.11.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "stripe": "^22.3.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^9.0.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
