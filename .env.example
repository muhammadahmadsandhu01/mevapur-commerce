# ==============================================================================
# MevaPur Commerce — Unified Deployment Environment Template (.env.example)
# Classification: All sensitive items must be supplied at runtime; do not commit secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Release & Topology Hosts
# ------------------------------------------------------------------------------
RELEASE_TAG=v1.0.0
STOREFRONT_HOST=localhost
ADMIN_HOST=admin.localhost
API_HOST=api.localhost

# ------------------------------------------------------------------------------
# 2. MongoDB Database Credentials (Non-Root App User & Root Admin)
# ------------------------------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace_with_strong_mongo_root_password
MONGO_APP_DATABASE=mevapur-commerce
MONGO_APP_USER=mevapur_app
MONGO_APP_PASSWORD=replace_with_strong_app_password

# ------------------------------------------------------------------------------
# 3. Redis Distributed Cache & Rate Limiting Credentials
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password
RATE_LIMIT_STORE=redis

# ------------------------------------------------------------------------------
# 4. Security, JWT & Cookies
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_64_character_cryptographic_jwt_secret
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_64_character_cryptographic_refresh_secret
JWT_REFRESH_EXPIRE=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 5. Email & Notification Configuration
# Modes: disabled, mock, smtp, brevo
# ------------------------------------------------------------------------------
EMAIL_MODE=mock
EMAIL_BRAND_NAME=HARZAAR

# ------------------------------------------------------------------------------
# 6. Commerce & Feature Flags
# ------------------------------------------------------------------------------
COMMERCE_MONEY_MODE=legacy
COMMERCE_TWO_PHASE_CHECKOUT_ENABLED=true
