# ------------------------------------------------------------------------------
# 3. Backend API HTTPS Virtual Host (${API_HOST})
# ------------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_HOST};

    ssl_certificate /etc/letsencrypt/live/${API_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    # Dedicated webhook routing: forwards original request bytes unaltered
    location /api/payments/webhooks {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_pass_request_headers on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    location /api/payments/webhook {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_pass_request_headers on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    # Deny public access to internal metrics
    location /api/metrics {
        return 403 '{"error":{"code":"ACCESS_DENIED","message":"Internal metrics endpoint not available via public gateway"}}';
        add_header Content-Type application/json always;
    }

    # Health Probes
    location /health/live {
        proxy_pass http://backend_upstream/health/live;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        access_log off;
    }

    location /health/ready {
        proxy_pass http://backend_upstream/health/ready;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        access_log off;
    }

    location /api/health {
        proxy_pass http://backend_upstream/api/health;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        access_log off;
    }

    location /api/ready {
        proxy_pass http://backend_upstream/api/ready;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        access_log off;
    }

    location / {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }
}
