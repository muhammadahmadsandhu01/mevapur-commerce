# ------------------------------------------------------------------------------
# 3. Backend API Virtual Host (${API_HOST})
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${API_HOST};

    # Dedicated webhook routing: forwards original request bytes unaltered
    location /api/payments/webhooks {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_pass_request_headers on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    location /api/payments/webhook {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_pass_request_headers on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    # Deny public access to internal operational metrics
    location /api/metrics {
        return 403 '{"error":{"code":"ACCESS_DENIED","message":"Internal metrics endpoint not available via public gateway"}}';
        add_header Content-Type application/json always;
    }

    # Health & Readiness Probes
    location /health/live {
        proxy_pass http://backend_upstream/health/live;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        access_log off;
    }

    location /health/ready {
        proxy_pass http://backend_upstream/health/ready;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        access_log off;
    }

    location /api/health {
        proxy_pass http://backend_upstream/api/health;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        access_log off;
    }

    location /api/ready {
        proxy_pass http://backend_upstream/api/ready;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        access_log off;
    }

    # General API endpoints
    location / {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }
}
